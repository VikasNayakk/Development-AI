# Local model configuration using Ollama (no cloud API key required).
HOST=127.0.0.1
PORT=8787

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5:7b

# Add your exact extension origin after loading the unpacked extension.
ALLOWED_EXTENSION_ORIGINS=chrome-extension://YOUR_EXTENSION_ID

# Optional alternative: OpenAI-compatible provider.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://your-compatible-provider.example/v1
# AI_API_KEY=
# AI_MODEL=
