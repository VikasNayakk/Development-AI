# Copy this file to .env and fill in your provider settings.
# Never commit .env or put provider keys in the browser extension.

HOST=127.0.0.1
PORT=8787

# OpenAI-compatible chat completions endpoint
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional: comma-separated allowed browser-extension origins.
# Leave empty for local-only development. Configure the extension origin
# explicitly before deploying beyond localhost.
ALLOWED_EXTENSION_ORIGINS=
