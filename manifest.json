{
  "manifest_version": 3,
  "name": "Development AI",
  "version": "0.2.0",
  "description": "An AI-assisted browser workflow extension.",
  "action": {
    "default_title": "Development AI",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage"]
}
