{
  "manifest_version": 3,
  "name": "Development AI",
  "version": "0.4.0",
  "description": "An AI-assisted browser workflow extension powered by local AI.",
  "action": {
    "default_title": "Development AI",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"]
}
